{
  "@context": "https://openvex.dev/ns/v0.2.0",
  "@id": "https://openvex.dev/docs/public/vex-sds-object-seaweedfs",
  "author": "Deckhouse <contact@deckhouse.io>",
  "version": 1,
  "statements": [
    {
      "vulnerability": {
        "name": "GO-2026-5932"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto@v0.53.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "Advisory covers the unmaintained golang.org/x/crypto/openpgp subpackage. In the upstream SeaweedFS `weed` binary golang.org/x/crypto is pulled in only for HKDF key derivation in the S3 API server (github.com/seaweedfs/seaweedfs/weed/s3api -> golang.org/x/crypto/hkdf); `go mod why golang.org/x/crypto/openpgp` in the SeaweedFS 4.39 source tree reports that the main module does not need the openpgp package, so it is not compiled into the binary and the vulnerable code is not in the execution path. golang.org/x/crypto has no release that drops openpgp, so the finding cannot be resolved by upgrading."
    }
  ],
  "timestamp": "2026-07-27T00:00:00Z"
}
